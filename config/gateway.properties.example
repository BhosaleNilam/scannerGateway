# CafeGuard backend (different network — outbound HTTPS only)
cafeguard.baseUrl=https://cafeguard.techbrewery.ca
cafeguard.email=cafe-owner@example.com
cafeguard.password=CHANGE_ME

# How the USB scanner is attached:
#   keyboard — global HID hook (best for Mac Mini auto-start / reboot)
#   stdin    — HID into the focused Terminal window only
#   serial   — USB serial / COM mode
scanner.mode=keyboard
scanner.serialPort=
scanner.baudRate=9600

# Local SQLite queue (survives restarts / offline periods)
queue.dbPath=./data/scans.db

# Background sender
sender.pollIntervalMs=2000
sender.maxAttempts=12
sender.retryDelayMs=5000

# Ignore identical barcodes scanned within this window (ms)
scanner.dedupeWindowMs=15000
