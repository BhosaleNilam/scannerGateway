<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.cafeguard.scanner</string>

  <key>WorkingDirectory</key>
  <string>__INSTALL_DIR__</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/libexec/java_home</string>
    <string>-v</string>
    <string>21</string>
    <string>--exec</string>
    <string>java</string>
    <string>-jar</string>
    <string>__INSTALL_DIR__/scanner-gateway.jar</string>
    <string>__INSTALL_DIR__/config/gateway.properties</string>
  </array>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>__INSTALL_DIR__/data/gateway.out.log</string>

  <key>StandardErrorPath</key>
  <string>__INSTALL_DIR__/data/gateway.err.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>JAVA_TOOL_OPTIONS</key>
    <string>-Dorg.slf4j.simpleLogger.defaultLogLevel=info</string>
  </dict>
</dict>
</plist>
